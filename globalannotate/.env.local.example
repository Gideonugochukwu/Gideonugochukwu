# GlobalAnnotate environment variables
# Copy this file to `.env.local` and fill in the values.
#
# Both forms (Get a Quote on /contact and Leave a Review on /reviews) POST to Formspree.
# You can create free form endpoints at https://formspree.io — sign up, create a form,
# and Formspree will give you a URL like https://formspree.io/f/abcdwxyz
#
# Configure where each form's submissions are delivered inside Formspree (it does NOT
# need to match the address displayed on the site). For now you can deliver to any
# inbox (including a personal Gmail); switch the delivery address to
# info@globalannotate.com once that mailbox is live in Google Workspace / Zoho.

# Endpoint for the "Get a Quote / Order a Service" form on /contact
NEXT_PUBLIC_FORMSPREE_QUOTE_ENDPOINT=

# Endpoint for the "Leave a Review" form on /reviews
NEXT_PUBLIC_FORMSPREE_REVIEW_ENDPOINT=

# Endpoint for the "Join Our Network" freelancer application form on /freelancers.
# This is NOT Formspree — it's a free Google Apps Script web app that writes
# applications straight into your roster Google Sheet. See GOOGLE_SHEET_SETUP.md
# in the repo root for the full, step-by-step setup guide. The value looks like:
# https://script.google.com/macros/s/AKfycb..................../exec
NEXT_PUBLIC_FREELANCER_FORM_ENDPOINT=

# ── Baidu / China (/zh locale) ────────────────────────────────────────────────
# Baidu webmaster verification code (百度搜索资源平台 → 站点管理 → HTML 标签验证).
# Paste only the content value, e.g. codeva-AbCdEf1234. Emits
# <meta name="baidu-site-verification"> once set.
NEXT_PUBLIC_BAIDU_VERIFY=
# Baidu URL-submission token (普通收录 → API 提交). Server-side only; used by
# POST /api/baidu-push. Never commit the real value.
BAIDU_PUSH_TOKEN=
# Optional shared secret for POST /api/baidu-push (send as
# "Authorization: Bearer <secret>"). Recommended in production so nobody else
# can spend the daily Baidu quota.
BAIDU_PUSH_SECRET=
# Optional Baidu Analytics (百度统计) site ID. Loaded on /zh pages only, and
# only after the visitor accepts analytics cookies.
NEXT_PUBLIC_BAIDU_ANALYTICS_ID=
